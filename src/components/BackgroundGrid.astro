---
---
<div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden bg-slate-50 dark:bg-[#0f0f0f] transition-colors duration-500">
    <!-- Glow Layer -->
    <div class="absolute inset-0 glow-layer"></div>
    
    <!-- Grid Lines -->
    <div class="absolute inset-0 grid-lines animate-grid-pulse"></div>
    
    <!-- Grid Dots (Moving Pulse at Intersections) -->
    <div class="absolute inset-0 grid-dots"></div>
    
    <!-- Vignette to fade out edges -->
    <div class="absolute inset-0 vignette"></div>
</div>

<style>
    .grid-lines {
        background-size: 40px 40px;
        background-image: 
            linear-gradient(to right, rgba(15, 23, 42, 0.04) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(15, 23, 42, 0.04) 1px, transparent 1px);
    }
    :global(.dark) .grid-lines {
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    }

    .grid-dots {
        background-size: 40px 40px;
        background-image: radial-gradient(circle at 1px 1px, rgba(15, 23, 42, 0.15) 1.5px, transparent 1.5px);
        -webkit-mask-image: 
            radial-gradient(circle 300px at 0% 0%, black, transparent 80%),
            radial-gradient(circle 400px at 100% 100%, black, transparent 80%);
        -webkit-mask-size: 200% 200%;
        -webkit-mask-repeat: no-repeat;
        animation: mask-move 20s infinite alternate ease-in-out;
    }
    :global(.dark) .grid-dots {
        background-image: radial-gradient(circle at 1px 1px, rgba(244, 63, 94, 0.5) 1.5px, transparent 1.5px);
    }

    .glow-layer {
        background: 
            radial-gradient(circle at 20% 30%, rgba(244, 63, 94, 0.03) 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(244, 63, 94, 0.03) 0%, transparent 40%);
        background-size: 200% 200%;
        animation: glow-move 25s infinite alternate ease-in-out;
    }
    :global(.dark) .glow-layer {
        background: 
            radial-gradient(circle at 20% 30%, rgba(244, 63, 94, 0.1) 0%, transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(244, 63, 94, 0.08) 0%, transparent 40%);
    }

    .vignette {
        background: radial-gradient(circle at 50% 50%, transparent 30%, rgba(248, 250, 252, 0.8) 100%);
    }
    :global(.dark) .vignette {
        background: radial-gradient(circle at 50% 50%, transparent 30%, rgba(15, 15, 15, 0.9) 100%);
    }

    @keyframes mask-move {
        0% { -webkit-mask-position: 0% 0%, 100% 100%; }
        50% { -webkit-mask-position: 100% 0%, 0% 100%; }
        100% { -webkit-mask-position: 100% 100%, 0% 0%; }
    }

    @keyframes glow-move {
        0% { background-position: 0% 0%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 50% 100%; }
    }

    .animate-grid-pulse {
        animation: grid-pulse 10s ease-in-out infinite alternate;
    }

    @keyframes grid-pulse {
        0% { opacity: 0.6; }
        100% { opacity: 1; }
    }
</style>
