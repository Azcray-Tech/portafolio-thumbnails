---
const currentLocale = Astro.currentLocale || 'es';
const i18n = (await import(`../i18n/${currentLocale}.json`)).default;
const base = import.meta.env.BASE_URL;
---
<div class="flex flex-col md:flex-row items-center justify-between gap-6 p-8 md:p-12 rounded-2xl bg-slate-900 dark:bg-white/5 border border-slate-200 dark:border-white/10 overflow-hidden relative mt-4">
    <div class="absolute -top-20 -right-20 w-64 h-64 bg-rose-500/20 blur-3xl rounded-full pointer-events-none"></div>
    <div class="relative z-10 flex flex-col gap-2 max-w-2xl">
        <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight uppercase">
            {i18n.cta.title}
        </h2>
        <p class="text-slate-400 leading-relaxed text-sm md:text-base">
            {i18n.cta.subtitle}
        </p>
    </div>
    <a href={`${base}/${currentLocale}/${i18n.routes.pricing}`} class="relative z-10 shrink-0 px-8 py-4 bg-rose-500 text-white font-black uppercase tracking-wider rounded-lg hover:bg-rose-600 transition-colors cursor-pointer">
        {i18n.cta.button}
    </a>
</div>
