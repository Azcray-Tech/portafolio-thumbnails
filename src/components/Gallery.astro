---
import { thumbnails } from '../data/thumbnails.js';
const currentLocale = Astro.currentLocale || 'es';
const i18n = (await import(`../i18n/${currentLocale}.json`)).default;
const lightboxCopyright = i18n.lightbox.copyright.replace('{year}', String(new Date().getFullYear()));
---
<div class="mb-8">
    <div class="max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-black mb-2 tracking-tight uppercase">
            {i18n.gallery.title} <span class="text-rose-500">{i18n.gallery.titleHighlight}</span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed text-sm md:text-base">
            {i18n.gallery.subtitle}
        </p>
    </div>
</div>

<div class="flex flex-col gap-4 mb-6">
    <div>
        <h2 class="text-2xl md:text-3xl font-black tracking-tight uppercase text-slate-900 dark:text-white">
            {i18n.gallery.sectionTitle}
        </h2>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed text-sm md:text-base mt-2">
            {i18n.gallery.sectionSubtitle}
        </p>
    </div>
    <h3 class="sr-only">{i18n.gallery.categoriesTitle}</h3>
    <div class="flex flex-wrap gap-2" id="filter-buttons">
        <button data-filter="all" class="filter-btn px-4 py-2 bg-rose-500 text-white text-xs font-bold rounded uppercase tracking-wider transition-colors cursor-pointer">{i18n.gallery.filters.all}</button>
        <button data-filter="gaming" class="filter-btn px-4 py-2 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-100 text-xs font-bold rounded uppercase tracking-wider hover:border-rose-500 dark:hover:border-rose-500 transition-colors cursor-pointer">{i18n.gallery.filters.gaming}</button>
        <button data-filter="sport" class="filter-btn px-4 py-2 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-100 text-xs font-bold rounded uppercase tracking-wider hover:border-rose-500 dark:hover:border-rose-500 transition-colors cursor-pointer">{i18n.gallery.filters.sport}</button>
        <button data-filter="entertainment" class="filter-btn px-4 py-2 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-100 text-xs font-bold rounded uppercase tracking-wider hover:border-rose-500 dark:hover:border-rose-500 transition-colors cursor-pointer">{i18n.gallery.filters.entertainment}</button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 flex-1" id="gallery-grid">
    {thumbnails.map(thumb => (
        <a href={import.meta.env.BASE_URL + thumb.src} data-lightbox data-category={thumb.category} class="thumbnail-card group relative rounded-xl overflow-hidden bg-white dark:bg-white/5 aspect-video border border-slate-200 dark:border-white/10 shadow-lg shadow-black/5 dark:shadow-black/50 block cursor-pointer transition-colors">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4 z-10">
                <p class="text-sm font-bold text-white translate-y-2 group-hover:translate-y-0 transition-transform duration-300">{thumb.title[currentLocale]}</p>
                <p class="text-[10px] text-rose-400 uppercase tracking-wider">{i18n.gallery.categoryLabel} {i18n.gallery.filters[thumb.category]}</p>
            </div>
            <div class="w-full h-full bg-slate-200 dark:bg-neutral-800 flex items-center justify-center">
                <img src={import.meta.env.BASE_URL + thumb.src} alt={thumb.title[currentLocale]} class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
            </div>
        </a>
    ))}
</div>

<nav id="pagination" class="flex items-center justify-center gap-2 mt-8" aria-label={i18n.pagination.label} data-page-label={i18n.pagination.pageLabel}></nav>

<!-- Vanilla JS Lightbox Implementation -->
<div id="lightbox" class="fixed inset-0 bg-black/95 z-50 hidden flex-col items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white hover:text-rose-500 font-bold text-3xl p-2 cursor-pointer transition-colors z-[60]" aria-label={i18n.lightbox.close}>✕</button>
    <button id="lightbox-prev" class="absolute left-4 md:left-8 top-1/2 -translate-y-1/2 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-rose-500 transition-colors cursor-pointer z-[60]" aria-label={i18n.lightbox.previous}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button id="lightbox-next" class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white hover:bg-rose-500 transition-colors cursor-pointer z-[60]" aria-label={i18n.lightbox.next}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <img id="lightbox-img" src="" class="max-w-[85%] max-h-[76.5vh] object-contain rounded shadow-2xl shadow-rose-500/10">
    <p id="lightbox-title" class="text-white mt-4 font-bold tracking-widest uppercase text-sm"></p>
    <p id="lightbox-copyright" class="text-sm text-slate-300 mt-2 tracking-wide">{lightboxCopyright}</p>
</div>

<script>
    const PER_PAGE = 20;
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.thumbnail-card');
    const pagination = document.getElementById('pagination');

    let activeFilter = 'all';
    let currentPage = 1;

    const getFilteredCards = () => {
        return Array.from(cards).filter(card => activeFilter === 'all' || card.getAttribute('data-category') === activeFilter);
    };

    const renderPagination = (totalPages) => {
        if (!pagination) return;
        pagination.innerHTML = '';

        if (totalPages <= 1) {
            pagination.style.display = 'none';
            return;
        }

        pagination.style.display = 'flex';
        const pageLabel = pagination.getAttribute('data-page-label') || '';

        for (let page = 1; page <= totalPages; page++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = page;
            if (pageLabel) btn.setAttribute('aria-label', pageLabel.replace('{page}', String(page)));
            btn.className = 'page-btn w-11 h-11 rounded-full bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-100 font-black text-sm transition-colors cursor-pointer hover:border-rose-500 dark:hover:border-rose-500';
            if (page === currentPage) {
                btn.classList.remove('bg-white', 'dark:bg-white/5', 'border-slate-200', 'dark:border-white/10');
                btn.classList.add('bg-rose-500', 'text-white', 'border-rose-500');
                btn.setAttribute('aria-current', 'page');
            }
            btn.addEventListener('click', () => {
                currentPage = page;
                applyView();
            });
            pagination.appendChild(btn);
        }
    };

    const applyView = () => {
        const filtered = getFilteredCards();
        const totalPages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
        currentPage = Math.min(currentPage, totalPages);

        const start = (currentPage - 1) * PER_PAGE;
        const end = start + PER_PAGE;

        Array.from(cards).forEach(card => {
            card.style.display = 'none';
        });

        filtered.forEach((card, i) => {
            if (i >= start && i < end) {
                card.style.display = 'block';
                card.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, fill: 'forwards' });
            }
        });

        renderPagination(totalPages);
    };

    buttons.forEach(button => {
        button.addEventListener('click', () => {
            buttons.forEach(btn => {
                btn.classList.remove('bg-rose-500', 'text-white');
                btn.classList.add('bg-white', 'dark:bg-white/5', 'border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-100');
            });
            button.classList.remove('bg-white', 'dark:bg-white/5', 'border-slate-200', 'dark:border-white/10', 'text-slate-700', 'dark:text-slate-100');
            button.classList.add('bg-rose-500', 'text-white');

            activeFilter = button.getAttribute('data-filter');
            currentPage = 1;
            applyView();
        });
    });

    // Lightbox logic
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const closeBtn = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    let lightboxIndex = 0;

    const openLightbox = (card, index) => {
        lightboxIndex = index;
        showLightboxCard(card);
        if (lightbox) {
            lightbox.classList.remove('hidden');
            lightbox.style.display = 'flex';
            void lightbox.offsetWidth;
            lightbox.classList.remove('opacity-0');
            lightbox.classList.add('opacity-100');
        }
    };

    const showLightboxCard = (card) => {
        const img = card.querySelector('img');
        const title = card.querySelector('p.text-sm');
        if (img && lightboxImg) lightboxImg.src = img.src;
        if (title && lightboxTitle) lightboxTitle.innerText = title.textContent || '';
    };

    const showLightboxAt = (index) => {
        const filtered = getFilteredCards();
        if (!filtered.length) return;
        lightboxIndex = (index + filtered.length) % filtered.length;
        showLightboxCard(filtered[lightboxIndex]);
    };

    document.querySelectorAll('[data-lightbox]').forEach((card) => {
        card.addEventListener('click', (e) => {
            e.preventDefault();
            openLightbox(card, getFilteredCards().indexOf(card));
        });
    });

    const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.classList.remove('opacity-100');
        lightbox.classList.add('opacity-0');
        setTimeout(() => {
            lightbox.style.display = 'none';
            lightbox.classList.add('hidden');
        }, 300);
    };

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (lightboxPrev) lightboxPrev.addEventListener('click', (e) => { e.stopPropagation(); showLightboxAt(lightboxIndex - 1); });
    if (lightboxNext) lightboxNext.addEventListener('click', (e) => { e.stopPropagation(); showLightboxAt(lightboxIndex + 1); });

    if (lightbox) {
        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });
    }

    document.addEventListener('keydown', (e) => {
        if (!lightbox) return;
        const isOpen = !lightbox.classList.contains('hidden');
        if (e.key === 'Escape' && isOpen) closeLightbox();
        if (isOpen && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
            e.preventDefault();
            showLightboxAt(e.key === 'ArrowLeft' ? lightboxIndex - 1 : lightboxIndex + 1);
        }
    });

    // Bloquear menú contextual (Guardar imagen como...) en miniaturas y lightbox
    cards.forEach(card => {
        card.addEventListener('contextmenu', (e) => e.preventDefault());
    });
    lightboxImg.addEventListener('contextmenu', (e) => e.preventDefault());

    applyView();
</script>
