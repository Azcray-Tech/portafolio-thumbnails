---
const currentLocale = Astro.currentLocale;
const base = import.meta.env.BASE_URL;

// Construye la URL base para el cambio de idioma
const targetLocale = currentLocale === 'es' ? 'en' : 'es';
const esUrl = `${base}/es/`;
const enUrl = `${base}/en/`;
---
<div class="flex items-center gap-4 bg-white dark:bg-white/5 p-1 rounded-full px-3 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none">
    <a href={esUrl} class={`font-bold text-xs ${currentLocale === 'es' ? 'text-rose-500' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors'}`} data-lang="es">ES</a>
    <a href={enUrl} class={`font-bold text-xs ${currentLocale === 'en' ? 'text-rose-500' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors'}`} data-lang="en">EN</a>
</div>

<script>
    // Guarda la preferencia al hacer click
    document.querySelectorAll('[data-lang]').forEach(link => {
        link.addEventListener('click', (e) => {
            const lang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
            if(lang) {
                localStorage.setItem('lang-preference', lang);
            }
        });
    });
</script>
