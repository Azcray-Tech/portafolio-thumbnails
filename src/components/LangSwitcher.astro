---
const currentLocale = Astro.currentLocale || 'es';
const base = import.meta.env.BASE_URL;

const esI18n = (await import('../i18n/es.json')).default;
const enI18n = (await import('../i18n/en.json')).default;
const currentI18n = currentLocale === 'es' ? esI18n : enI18n;

// Preserva la página actual al cambiar de idioma (mapea la ruta a su equivalente)
const pathname = new URL(Astro.request.url).pathname;
const relPath = pathname.startsWith(base) ? pathname.slice(base.length) : pathname;
const slug = relPath.replace(/^\/(es|en)(?=\/|$)/, '').replace(/^\/+|\/+$/g, '');
const routeKey = Object.keys(currentI18n.routes).find(key => currentI18n.routes[key] === slug);
const esPath = routeKey ? `/${esI18n.routes[routeKey]}` : '';
const enPath = routeKey ? `/${enI18n.routes[routeKey]}` : '';

const esUrl = `${base}/es${esPath}/`;
const enUrl = `${base}/en${enPath}/`;
---
<div class="flex items-center gap-4 bg-white dark:bg-white/5 p-1 rounded-full px-3 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none">
    <a href={esUrl} class={`font-bold text-xs ${currentLocale === 'es' ? 'text-rose-500' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors'}`} data-lang="es">ES</a>
    <a href={enUrl} class={`font-bold text-xs ${currentLocale === 'en' ? 'text-rose-500' : 'text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors'}`} data-lang="en">EN</a>
</div>

<script>
    // Guarda la preferencia al hacer click
    document.querySelectorAll('[data-lang]').forEach(link => {
        link.addEventListener('click', (e) => {
            const lang = (e.currentTarget as HTMLElement).getAttribute('data-lang');
            if(lang) {
                localStorage.setItem('lang-preference', lang);
            }
        });
    });
</script>
