---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "AZCRAY.design - Transformo ideas en portadas visualmente atractivas y estratégicas, diseñadas a medida para captar a tu audiencia ideal y maximizar el rendimiento de cada video.",
  image = "/images/social-banner.webp",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const imageUrl = new URL(import.meta.env.BASE_URL + image, Astro.site || Astro.url.origin);

const esI18n = (await import('../i18n/es.json')).default;
const enI18n = (await import('../i18n/en.json')).default;
const currentLocale = Astro.currentLocale || 'es';
const currentI18n = currentLocale === 'es' ? esI18n : enI18n;

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const relPath = path.startsWith(base) ? path.slice(base.length) : path;
const slug = relPath.replace(/^\/(es|en)(?=\/|$)/, '').replace(/^\/+|\/+$/g, '');
const routeKey = Object.keys(currentI18n.routes).find(key => currentI18n.routes[key] === slug);
const esSlug = routeKey ? esI18n.routes[routeKey] : '';
const enSlug = routeKey ? enI18n.routes[routeKey] : '';

const site = Astro.site || Astro.url.origin;
const esHref = new URL(base + (esSlug ? `/es/${esSlug}/` : '/es/'), site).href;
const enHref = new URL(base + (enSlug ? `/en/${enSlug}/` : '/en/'), site).href;
const xDefaultHref = new URL(base + (esSlug ? `/es/${esSlug}/` : '/es/'), site).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href={import.meta.env.BASE_URL + "/favicon.ico"} />
<link rel="icon" type="image/png" sizes="32x32" href={import.meta.env.BASE_URL + "/favicon-32x32.png"} />
<link rel="icon" type="image/png" sizes="16x16" href={import.meta.env.BASE_URL + "/favicon-16x16.png"} />
<link rel="apple-touch-icon" sizes="180x180" href={import.meta.env.BASE_URL + "/apple-touch-icon.png"} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternates -->
<link rel="alternate" hreflang="es" href={esHref} />
<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
 
 <!-- Twitter -->
 <meta property="twitter:card" content="summary_large_image" />
 <meta property="twitter:url" content={Astro.url} />
 <meta property="twitter:title" content={title} />
 <meta property="twitter:description" content={description} />
 <meta property="twitter:image" content={imageUrl} />
