---
import '../global.css';
import LangSwitcher from '../components/LangSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import SEO from '../components/SEO.astro';
import BackgroundGrid from '../components/BackgroundGrid.astro';

const { title, description, image, type } = Astro.props;
const currentLocale = Astro.currentLocale || 'es';
const i18n = (await import(`../i18n/${currentLocale}.json`)).default;
const base = import.meta.env.BASE_URL;

const pathname = new URL(Astro.request.url).pathname;
// Helper to check active route
const isActive = (path) => {
    const fullPath = base + path;
    return pathname === fullPath || pathname === fullPath + '/';
};
---
<html lang={currentLocale} class="bg-slate-50 dark:bg-[#0f0f0f] text-slate-900 dark:text-slate-100 font-sans transition-colors duration-300">
<head>
    <script is:inline>
        const theme = (() => {
            if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                return localStorage.getItem('theme');
            }
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
            }
            return 'light';
        })();
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        }
    </script>
    <SEO 
        title={`${title} | AZCRAY.design`} 
        description={description} 
        image={image} 
        type={type} 
    />
</head>
<body class="min-h-screen flex flex-col bg-transparent transition-colors duration-300 relative">
    <BackgroundGrid />
    <div class="flex flex-col flex-1 w-full max-w-[1280px] mx-auto bg-transparent text-slate-900 dark:text-slate-100 font-sans border-x border-slate-200 dark:border-rose-500/10 shadow-2xl transition-colors duration-300">
        <header class="sticky top-0 z-50 flex flex-col md:flex-row items-center justify-between px-6 md:px-10 py-6 border-b border-slate-200 dark:border-white/5 shrink-0 gap-4 transition-colors duration-300 bg-slate-50/80 dark:bg-[#0f0f0f]/80 backdrop-blur-md">
            <a href={`${base}/${currentLocale}/`} class="flex items-center gap-2">
                <img src={`${base}/images/Logo.png`} alt="AZCRAY.design" class="h-8 w-auto" />
                <span class="text-xl font-bold tracking-tighter">AZCRAY<span class="text-rose-500 italic">.design</span></span>
            </a>
            <nav class="flex gap-4 md:gap-8 items-center text-sm md:text-base font-medium">
                <a href={`${base}/${currentLocale}/`} class={isActive(`/${currentLocale}/`) ? "text-rose-500 border-b-2 border-rose-500 pb-1" : "text-slate-600 dark:text-slate-100 hover:text-rose-500 dark:hover:text-rose-500 transition-colors pb-1"}>{i18n.nav.gallery}</a>
                <a href={`${base}/${currentLocale}/${i18n.routes.about}`} class={isActive(`/${currentLocale}/${i18n.routes.about}`) ? "text-rose-500 border-b-2 border-rose-500 pb-1" : "text-slate-600 dark:text-slate-100 hover:text-rose-500 dark:hover:text-rose-500 transition-colors pb-1"}>{i18n.nav.about}</a>
                <a href={`${base}/${currentLocale}/${i18n.routes.pricing}`} class={isActive(`/${currentLocale}/${i18n.routes.pricing}`) ? "text-rose-500 border-b-2 border-rose-500 pb-1" : "text-slate-600 dark:text-slate-100 hover:text-rose-500 dark:hover:text-rose-500 transition-colors pb-1"}>{i18n.nav.pricing}</a>
                <a href={`${base}/${currentLocale}/${i18n.routes.contact}`} class={isActive(`/${currentLocale}/${i18n.routes.contact}`) ? "text-rose-500 border-b-2 border-rose-500 pb-1" : "text-slate-600 dark:text-slate-100 hover:text-rose-500 dark:hover:text-rose-500 transition-colors pb-1"}>{i18n.nav.contact}</a>
            </nav>
            <div class="flex items-center gap-4">
                <ThemeToggle />
                <LangSwitcher />
            </div>
        </header>
        <main class="flex-1 flex flex-col p-6 md:p-10 py-8 gap-8">
            <slot />
        </main>
        <footer class="flex flex-col md:flex-row items-center justify-between px-6 md:px-10 py-4 bg-rose-500 text-black shrink-0 gap-4 mt-auto">
            <div class="text-[10px] font-bold tracking-widest flex items-center gap-4">
                <span>© {new Date().getFullYear()} AZCRAY</span><span>•</span><span>{i18n.footer.tagline}</span>
            </div>
            <div class="text-xs flex gap-6 font-medium">
                <span class="hidden md:inline">{i18n.footer.available}</span>
                <a href={`${base}/${currentLocale}/${i18n.routes.contact}`} class="font-black underline">{i18n.footer.cta} →</a>
            </div>
        </footer>
    </div>
</body>
</html>
