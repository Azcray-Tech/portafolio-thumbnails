---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Pricing">
    <div class="max-w-5xl mx-auto flex flex-col gap-12 w-full items-center pt-4">
        <div class="text-center">
            <h1 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tight uppercase mb-4">
                PLANS & <span class="text-rose-500">PRICING</span>
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-lg">Invest in your CTR. Choose the plan that best fits your channel.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full mt-4">
            <div class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-xl p-8 flex flex-col gap-6 shadow-sm dark:shadow-none">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider">Basic</h3>
                <div class="text-4xl font-black text-rose-500">$5<span class="text-base text-slate-500 font-normal">/thumbnail</span></div>
                <ul class="flex flex-col gap-3 text-sm text-slate-600 dark:text-slate-300 flex-1">
                    <li class="flex gap-2 items-center">✓ 1 thumbnail</li>
                    <li class="flex gap-2 items-center">✓ 2 Revisions</li>
                    <li class="flex gap-2 items-center">✓ 48h Delivery</li>
                </ul>
                <a href={`${base}/en/contact`} class="w-full text-center px-4 py-3 bg-slate-50 dark:bg-white/5 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors border border-slate-200 dark:border-white/10 rounded font-bold uppercase text-xs tracking-wider mt-4 block text-slate-700 dark:text-white">Choose Plan</a>
            </div>
            
            <div class="bg-white dark:bg-white/5 border-2 border-rose-500 rounded-xl p-8 flex flex-col gap-6 relative transform md:-translate-y-4 shadow-xl shadow-rose-500/5 dark:shadow-rose-500/10">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-rose-500 text-black text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full whitespace-nowrap">Most Popular</div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider">Standard</h3>
                <div class="text-4xl font-black text-rose-500">$10<span class="text-base text-slate-500 font-normal">/thumbnail</span></div>
                <ul class="flex flex-col gap-3 text-sm text-slate-600 dark:text-slate-300 flex-1">
                    <li class="flex gap-2 items-center text-slate-900 dark:text-white">✓ 1 thumbnail</li>
                    <li class="flex gap-2 items-center text-slate-900 dark:text-white">✓ Unlimited revisions</li>
                    <li class="flex gap-2 items-center">✓ Source file (PSD)</li>
                    <li class="flex gap-2 items-center">✓ 24h Delivery</li>
                </ul>
                <a href={`${base}/en/contact`} class="w-full text-center px-4 py-3 bg-rose-500 text-black hover:bg-rose-600 transition-colors rounded font-bold uppercase text-xs tracking-wider mt-4 block">Choose Plan</a>
            </div>
            
            <div class="bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-xl p-8 flex flex-col gap-6 shadow-sm dark:shadow-none">
                <h3 class="text-xl font-bold text-slate-900 dark:text-white uppercase tracking-wider">Premium</h3>
                <div class="text-4xl font-black text-rose-500">$15<span class="text-base text-slate-500 font-normal">/pack of 3</span></div>
                <ul class="flex flex-col gap-3 text-sm text-slate-600 dark:text-slate-300 flex-1">
                    <li class="flex gap-2 items-center">✓ 3 thumbnails</li>
                    <li class="flex gap-2 items-center">✓ 2 revisions per thumbnail</li>
                    <li class="flex gap-2 items-center">✓ Source file (PSD)</li>
                    <li class="flex gap-2 items-center">✓ 48h Delivery</li>
                </ul>
                <a href={`${base}/en/contact`} class="w-full text-center px-4 py-3 bg-slate-50 dark:bg-white/5 hover:bg-slate-100 dark:hover:bg-white/10 transition-colors border border-slate-200 dark:border-white/10 rounded font-bold uppercase text-xs tracking-wider mt-4 block text-slate-700 dark:text-white">Choose Plan</a>
            </div>
        </div>
    </div>
</BaseLayout>
